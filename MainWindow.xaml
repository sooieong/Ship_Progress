<Window x:Class="Ship_Progress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ship Building Progress Dashboard" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. 상단 헤더 (Top Header Bar)              -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <!-- 좌측: 로고 + 프로젝트 타이틀 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 상대 경로로 수정하여 이미지 깨짐 방지 -->
                    <Image Source="C:\Users\sooieong\source\repos\Ship_Progress\Images\Hanwha_Ocean_Logo.png"
                           Height="40" 
                           Stretch="Uniform"
                           Margin="0,0,16,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="선박 건조 프로젝트 종합 대시보드" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryTextBrush}" 
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"/>
                </StackPanel>

                <!-- 우측: 날짜/시간 & 알림 아이콘 & 새로고침 버튼 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- 🕒 [신규 추가] 실시간 날짜 및 시간 / 최종 업데이트 시간 표시 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,4"
            Margin="0,0,12,0"
            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DateTimeTextBlock" 
                       Text="2026-08-11 10:44:47" 
                       FontSize="13" 
                       Foreground="{DynamicResource PrimaryTextBrush}" 
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 알림 영역 -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="NotificationButton"
                                Height="36" 
                                Padding="8,0"
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Click="NotificationButton_Click"
                                ToolTip="알림">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔔" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="알림" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 알림 팝업 -->
                        <Popup x:Name="NotificationPopup"
                               PlacementTarget="{Binding ElementName=NotificationButton}"
                               Placement="Bottom"
                               IsOpen="False"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">

                            <Border Width="300" 
                                    Margin="0,8,0,0"
                                    Background="{DynamicResource HeaderBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.15" Direction="270"/>
                                </Border.Effect>

                                <StackPanel Margin="12">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="알림 센터" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="전체 읽음" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource AccentOrangeBrush}" Cursor="Hand"/>
                                    </Grid>

                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- 알림 카드 배경 및 글자색 DynamicResource 적용 -->
                                            <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="[위험] C SERIES - H116" FontWeight="SemiBold" FontSize="12" Foreground="#E53935"/>
                                                    <TextBlock Text="철의장 공정 8일 지연 발생" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="10분 전" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="[주의] A SERIES - H120" FontWeight="SemiBold" FontSize="12" Foreground="#FB8C00"/>
                                                    <TextBlock Text="배관 공정 자재 입고 지연" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="1시간 전" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="[완료] B SERIES 동기화" FontWeight="SemiBold" FontSize="12" Foreground="#43A047"/>
                                                    <TextBlock Text="실시간 품질 로그 데이터 업데이트 완료" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="2시간 전" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 새로고침 버튼 -->
                    <Button Height="36" 
                            Padding="8,0"
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Click="RefreshButton_Click"
                            ToolTip="새로고침">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="새로고침" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 메인 콘텐츠 구역                            -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. 좌측 사이드바 -->
            <Border Grid.Column="0" 
        Background="{DynamicResource SidebarBackgroundBrush}" 
        BorderBrush="{DynamicResource BorderBrush}" 
        BorderThickness="0,0,1,0">
                <Grid Margin="0,12,0,12">
                    <Grid.RowDefinitions>
                        <!-- 상단: 메뉴 버튼 영역 (가변 높이) -->
                        <RowDefinition Height="*"/>
                        <!-- 하단: 부서 협업 / 라이브 피드 영역 (자동 높이) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 상단 메뉴 버튼 목록 -->
                    <StackPanel Grid.Row="0">
                        <RadioButton Style="{StaticResource SidebarTabButtonStyle}" 
                         Tag="Tab1" 
                         IsChecked="True" 
                         Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="메인" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarTabButtonStyle}" 
                         Tag="Tab2"
                         Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚢" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="공정 분석" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarTabButtonStyle}" 
                         Tag="Tab3"
                         Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="납기 관리" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource SidebarTabButtonStyle}" 
                         Tag="Tab4"
                         Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="시스템 설정" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 하단 피드 영역 -->
                    <StackPanel Grid.Row="1" Margin="8,0">
                        <!-- 1. 메시지 입력 카드 -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10" 
                    Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="부서 협업/라이브 피드" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               Foreground="{DynamicResource PrimaryTextBrush}" 
                               Margin="0,0,0,8"/>

                                <TextBox x:Name="FeedInputTextBox" 
                             Height="60" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             Padding="4" 
                             FontSize="11" 
                             Background="#FAFAFA"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="멘션(@) 및 메시지 작성..."/>

                                <Button Content="[전송]" 
                            HorizontalAlignment="Right" 
                            Margin="0,6,0,0" 
                            Padding="8,2" 
                            FontSize="11" 
                            Click="SendFeedButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. 최근 피드 목록 카드 -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" 
        BorderBrush="{DynamicResource BorderBrush}" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="10">
                            <StackPanel>
                                <TextBlock Text="부서 협업/라이브 피드" 
                   FontWeight="Bold" 
                   FontSize="12" 
                   Foreground="{DynamicResource PrimaryTextBrush}" 
                   Margin="0,0,0,8"/>

                                <ScrollViewer x:Name="FeedScrollViewer" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <!-- x:Name="FeedListStackPanel" 추가 -->
                                    <StackPanel x:Name="FeedListStackPanel">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}">
                    <Run Text="[생산팀]" FontWeight="Bold"/> <Run Text="@구매팀_최부장" Foreground="#1976D2" FontWeight="Bold"/> <Run Text="H120 메안엔진 지연으로 탑재 순서 변경 검토 요청 (14:20)"/>
                                        </TextBlock>
                                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,6"/>

                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}">
                    <Run Text="[구매팀]" FontWeight="Bold"/> <Run Text="@PM_홍길동" Foreground="#1976D2" FontWeight="Bold"/> <Run Text="고압 LNG 밸브 공급처 교체 승인 요청 (11:15)"/>
                                        </TextBlock>
                                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,2,0,6"/>

                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}">
                    <Run Text="[PM]" FontWeight="Bold"/> <Run Text="@생산팀_김과장" Foreground="#1976D2" FontWeight="Bold"/> <Run Text="CP 영향 +2일로 확인, 일정 수정 진행하세요. (15:01)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 3. 메인 뷰 포트 -->
            <Border Grid.Column="1" Background="{DynamicResource MainContentBackgroundBrush}">
                <ContentControl x:Name="MainContentViewPort"/>
            </Border>
        </Grid>
    </Grid>
</Window>