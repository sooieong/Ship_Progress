<UserControl x:Class="Ship_Progress.Tab2_ShipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- 3행 위험 현황 표 상태 배지 스타일 -->
        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. 상단 호선 선택 & KPI 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 중단 시각화 영역 (S-Curve Canvas + 진행 공정 트랙) -->
            <RowDefinition Height="*"/>
            <!-- 3. 하단 시각화 영역 (LiveCharts 도넛 차트 + 위험 현황 표) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. 상단 호선 선택 & KPI 영역 -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- [1-1] 호선 선택 카드 -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource HeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="호선 선택" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">

                                <!-- H120 호선 카드 -->
                                <Border CornerRadius="4" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Tag="H120" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="H120" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="A SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- H121 호선 카드 -->
                                <Border CornerRadius="4" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Tag="H121" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="H121" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="A SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- H122 호선 카드 -->
                                <Border CornerRadius="4" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Tag="H122" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="H122" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="B SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- [1-2] 선택 호선 요약 및 KPI 통합 카드 -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource HeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚢" FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="선택 호선" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedShipNo}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}"/>
                            <TextBlock Text="{Binding SelectedSeriesName}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="종합 공정률" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="86.4" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="평균 자재 입고률" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="71.3" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="인도 예정일" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ExpectedEndDate}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. 중단 시각화 (좌: S-Curve / 우: 공정 단계) -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- [2-1] S-Curve 차트 카드 -->
            <Border Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="종합 공정률 S-Curve" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="8" Height="8" Fill="#1E88E5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="계획" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0" FontWeight="SemiBold"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource HanwhaOrangeBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="실적" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Canvas x:Name="ChartCanvas" Grid.Row="1" SizeChanged="ChartCanvas_SizeChanged" Background="Transparent">
                        <!-- 팝업 툴팁 -->
                        <Border x:Name="PointTooltip" Visibility="Collapsed" Background="#222222" CornerRadius="6" Padding="8,5" Canvas.ZIndex="100">
                            <TextBlock x:Name="TooltipText" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <!-- [2-2] 현재 진행 중인 공정 단계 카드 -->
            <Border Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <!-- 연결선 영역을 위한 행 추가 -->
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="현재 진행 중인 공정 단계" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <UniformGrid Grid.Row="1" Columns="9" VerticalAlignment="Center">
                        <!-- 1. 강재절단 -->
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="52" Height="52">
                                <Ellipse Fill="#22C55E"/>
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="강재절단" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="완료" FontSize="10" Foreground="#22C55E" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 화살표 1 -->
                        <TextBlock Text="›" FontSize="22" FontWeight="Bold" Foreground="#B0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0"/>

                        <!-- 2. 블록조립 -->
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="52" Height="52">
                                <Ellipse Fill="#22C55E"/>
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="블록조립" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="완료" FontSize="10" Foreground="#22C55E" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 화살표 2 -->
                        <TextBlock Text="›" FontSize="22" FontWeight="Bold" Foreground="#B0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0"/>

                        <!-- 3. 탑재 (진행중) -->
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="56" Height="56">
                                <Ellipse Fill="{DynamicResource HanwhaOrangeBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.3" 
                                                                     Duration="0:0:0.8" 
                                                                     AutoReverse="True" 
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="🏗" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="탑재" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="진행중" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 화살표 3 -->
                        <TextBlock Text="›" FontSize="22" FontWeight="Bold" Foreground="#B0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0"/>

                        <!-- 4. 의장 -->
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="52" Height="52">
                                <Ellipse Fill="{DynamicResource BorderBrush}"/>
                                <TextBlock Text="🛠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="의장" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="대기" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 화살표 4 -->
                        <TextBlock Text="›" FontSize="22" FontWeight="Bold" Foreground="#B0B0B0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0"/>

                        <!-- 5. 시운전 -->
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="52" Height="52">
                                <Ellipse Fill="{DynamicResource BorderBrush}"/>
                                <TextBlock Text="⚓" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="시운전" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="대기" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- 탑재 아이콘과 하단 박스를 이어주는 세로 연결선 -->
                    <Line Grid.Row="2" 
                          X1="0" Y1="-15" X2="0" Y2="16" 
                          Stroke="{DynamicResource BorderBrush}" 
                          StrokeThickness="1" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>

                    <!-- 하단 일정 및 진행률 수치 영역 -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="시작일" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="2026-05-05" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="예상 완료일" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="2026-09-30" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="진행률" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="62%" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource HanwhaOrangeBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. 하단 시각화 (좌: 4대 자재 도넛 / 우: 위험 현황 표) -->
        <!-- ========================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- [3-1] 블록별 공정 현황 카드 (가로 프로그래스 바 타입) -->
            <Border Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="블록 공정 현황" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding BlockProgressList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Left"/>

                                        <TextBlock Text="{Binding ProgressText}" 
                                                   Foreground="{Binding BarColor}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar Grid.Row="1" 
                                                 Height="14" 
                                                 Minimum="0" 
                                                 Maximum="100" 
                                                 Value="{Binding Progress}" 
                                                 Foreground="{Binding BarColor}" 
                                                 Background="#E0E0E0" 
                                                 BorderThickness="0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- [3-2] 위험 기자재 현황 표 카드 -->
            <Border Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="위험 품목 현황" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <DataGrid x:Name="H120RiskDataGrid" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="Transparent" 
                          RowHeight="36"
                          BorderThickness="0">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- [구분] 컬럼 -->
                            <DataGridTemplateColumn Width="65">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Width="50" Height="24">
                                            <TextBlock Text="구분" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                            <Button Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Click="ProcessFilterButton_Click" Cursor="Hand" ToolTip="구분 필터">
                                                <Path Data="M 2,4 L 18,4 L 11,12 L 11,18 L 9,18 L 9,12 Z" 
                                          Fill="#475569" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 나머지 컬럼들 -->
                            <DataGridTextColumn Header="기자재명" Binding="{Binding EquipmentName}" Width="*" ElementStyle="{StaticResource CenterAlignedCell}"/>
                            <DataGridTextColumn Header="지연 일수" Binding="{Binding DelayText}" Width="60" ElementStyle="{StaticResource CenterAlignedCell}"/>

                            <!-- 1. 상태 컬럼 -->
                            <DataGridTemplateColumn Header="상태" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBorderStyle}" Background="{Binding StatusBgColor}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFgColor}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. 주공정 영향 컬럼 -->
                            <DataGridTemplateColumn Header="주공정 영향" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBorderStyle}" Background="{Binding StatusBgColor}">
                                            <TextBlock Text="{Binding MainProcessImpact}" 
                                           Foreground="{Binding StatusFgColor}" 
                                           FontWeight="Bold" 
                                           FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>