<UserControl x:Class="Ship_Progress.Views.Tab3_LeadtimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- 3행 위험 현황 표 상태 배지 스타일 -->
        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 1. 상단 호선 선택 & KPI 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 중단 시각화 영역 (좌: 납기 현황 차트 + 우: 위험 기자재 현황 표) -->
            <RowDefinition Height="*"/>
            <!-- 3. 하단 시각화 영역 (좌: 추후 확장 영역 + 우: 결품/지연 알림) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. 상단 호선 선택 & KPI 영역 -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- [1-1] 호선 선택 카드 -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource HeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="호선 선택" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">

                                <!-- H120 호선 카드 -->
                                <Border CornerRadius="4" Padding="12,6" Margin="0,0,6,0" Cursor="Hand" Tag="H120" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- FontSize를 15로 통일 -->
                                        <TextBlock Text="H120" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="A SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H120">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- H121 호선 카드 -->
                                <Border CornerRadius="4" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Tag="H121" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="H121" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="A SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H121">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- H122 호선 카드 -->
                                <Border CornerRadius="4" Padding="10,6" Margin="0,0,6,0" Cursor="Hand" Tag="H122" MouseDown="ShipCard_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                    <Setter Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="H122" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="A SERIES" FontSize="9" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedShipNo}" Value="H122">
                                                            <Setter Property="Foreground" Value="#FFE0C2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- [1-2] 선택 호선 요약 및 납기 관리 KPI 통합 카드 -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource HeaderBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 선택 호선 정보 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Images/ship_icon.png" 
Width="50" Height="50" 
VerticalAlignment="Center" 
Margin="0,0,30,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="선택 호선" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedShipNo}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}"/>
                            <TextBlock Text="{Binding SelectedSeriesName}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <!-- KPI 1: 정시 납품 (초록색: #22C55E) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="납품 완료" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding KpiCompletedCount}" FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                            <TextBlock Text="건" FontSize="14" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Bottom" Margin="2,0,4,3"/>
                            <TextBlock Text="{Binding KpiCompletedPercent}" FontSize="11" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <!-- KPI 2: 지연 (오렌지: HanwhaOrangeBrush) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="지연" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding KpiDelayCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}"/>
                            <TextBlock Text="건" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}" VerticalAlignment="Bottom" Margin="2,0,4,3"/>
                            <TextBlock Text="{Binding KpiDelayPercent}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HanwhaOrangeBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" HorizontalAlignment="Right" Margin="0,5"/>

                    <!-- KPI 3: 보류/대기 (빨간색: #E53935) -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="보류/대기" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding KpiHoldCount}" FontSize="22" FontWeight="Bold" Foreground="#E53935"/>
                            <TextBlock Text="건" FontSize="14" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Bottom" Margin="2,0,4,3"/>
                            <TextBlock Text="{Binding KpiHoldPercent}" FontSize="11" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. 중단 시각화 영역 (하나의 큰 카드 안에 좌: 차트 / 우: DB) -->
        <!-- ========================================== -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 좌측 차트 영역 -->
                    <ColumnDefinition Width="1*"/>
                    <!-- 세로 구분선 간격 -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <!-- 우측 DB 영역 -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- [2-1] 좌측: 납기 현황 차트 카드 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 카드 타이틀 및 범례 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <!-- 1. 좌측 타이틀 -->
                        <TextBlock Text="납기 현황 차트" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <!-- 2. 중앙 범례 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="목표" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="현재 입고" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Ellipse Width="10" Height="10" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="잔여 필요량" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 3. 우측 페이지네이션 컨트롤 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,35,0">
                            <Button Content="◀" Click="ChartPrevPage_Click" FontSize="9" Padding="4,2" Margin="0,0,4,0" Cursor="Hand"/>
                            <TextBlock x:Name="ChartPageInfoTextBlock" Text="1 / 1" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="2,0"/>
                            <Button Content="▶" Click="ChartNextPage_Click" FontSize="9" Padding="4,2" Margin="4,0,0,0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- 캔버스 차트 영역 -->
                    <Canvas x:Name="LeadtimeChartCanvas" Grid.Row="1" SizeChanged="LeadtimeChartCanvas_SizeChanged" Background="Transparent">
                        <!-- 마우스 툴팁 -->
                        <Border x:Name="LeadtimeTooltip" Visibility="Collapsed" Background="#222222" CornerRadius="6" Padding="8,5" Canvas.ZIndex="100">
                            <TextBlock x:Name="LeadtimeTooltipText" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- 차트와 DB를 구분하는 세로선 -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,4"/>

                <!-- [2-2] 우측: 위험 기자재 현황 표 카드 -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상단 타이틀 + 검색창 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="납기 현황 DB" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="SearchTextBox" Width="130" Height="24" FontSize="11" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,8,0"
                                     Text="품목명 검색..."
                                     Foreground="Gray"
                                     GotFocus="SearchTextBox_GotFocus"
                                     LostFocus="SearchTextBox_LostFocus"
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 납기 현황 DataGrid -->
                    <DataGrid x:Name="LeadtimeRiskDataGrid" Grid.Row="1" 
          AutoGenerateColumns="False" 
          IsReadOnly="False" 
          CanUserSortColumns="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
          Background="Transparent" 
          RowHeight="36"
          BorderThickness="0">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Resources>
                            <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- 체크박스 컬럼 -->
                            <DataGridTemplateColumn Header="선택" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  IsEnabled="{Binding IsEnabled}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Checked="RiskItem_CheckChanged" Unchecked="RiskItem_CheckChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 구분 컬럼 -->
                            <DataGridTemplateColumn Width="65">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Width="50" Height="24">
                                            <TextBlock Text="구분" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                            <Button Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Click="CategoryFilterButton_Click" Cursor="Hand" ToolTip="구분 필터">
                                                <Path Data="M 2,4 L 18,4 L 11,12 L 11,18 L 9,18 L 9,12 Z" 
                                                      Fill="#475569" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Category}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 품목명 컬럼 -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding EquipmentName}" Width="*" ElementStyle="{StaticResource CenterAlignedCell}"/>

                            <!-- 협력사 컬럼 -->
                            <DataGridTemplateColumn Width="105">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Width="90" Height="24">
                                            <TextBlock Text="협력사" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0"/>
                                            <Button Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Click="VendorFilterButton_Click" Cursor="Hand" ToolTip="협력사 필터">
                                                <Path Data="M 2,4 L 18,4 L 11,12 L 11,18 L 9,18 L 9,12 Z" 
                                                      Fill="#475569" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Vendor}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 납기일 컬럼 -->
                            <DataGridTextColumn Header="납기일" Binding="{Binding DeliveryDate}" Width="90" ElementStyle="{StaticResource CenterAlignedCell}"/>

                            <!-- 지연일수 컬럼 -->
                            <DataGridTextColumn Header="지연일수" Binding="{Binding RemainingDaysText}" Width="70" ElementStyle="{StaticResource CenterAlignedCell}"/>

                            <!-- 상태 컬럼 -->
                            <DataGridTemplateColumn Width="75">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Width="60" Height="24">
                                            <TextBlock Text="상태" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                            <Button Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    Click="StatusFilterButton_Click" Cursor="Hand" ToolTip="상태 필터">
                                                <Path Data="M 2,4 L 18,4 L 11,12 L 11,18 L 9,18 L 9,12 Z" 
                                                      Fill="#475569" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Binding StatusBgColor}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFgColor}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- 3. 하단 시각화 (좌: 추후 확장 영역 / 우: 결품/지연 알림) -->
        <!-- ========================================== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- [3-1] 좌측: 발주완료, 검사완료, 입고 3개 도넛 차트 영역 -->
            <Border Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="자재 공정 현황 요약" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <!-- 3개의 도넛 차트를 가로로 나란히 배치 및 세로 구분선 추가 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. 발주 완료 차트 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="발주 완료" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Grid Width="100" Height="100">
                                <lvc:PieChart StartingRotationAngle="0" InnerRadius="35" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" LegendLocation="None" Series="{Binding OrderGaugeSeries}"/>
                                <TextBlock Text="{Binding OrderPercentText}" FontSize="15" FontWeight="Bold" Foreground="{Binding OrderColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- 첫 번째 구분선 -->
                        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,10"/>

                        <!-- 2. 검사 완료 차트 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="검사 완료" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Grid Width="100" Height="100">
                                <lvc:PieChart StartingRotationAngle="0" InnerRadius="35" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" LegendLocation="None" Series="{Binding InspectGaugeSeries}"/>
                                <TextBlock Text="{Binding InspectPercentText}" FontSize="15" FontWeight="Bold" Foreground="{Binding InspectColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- 두 번째 구분선 -->
                        <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="0,10"/>

                        <!-- 3. 입고 차트 -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="입고" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Grid Width="100" Height="100">
                                <lvc:PieChart StartingRotationAngle="0" InnerRadius="35" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" LegendLocation="None" Series="{Binding ReceiveGaugeSeries}"/>
                                <TextBlock Text="{Binding ReceivePercentText}" FontSize="15" FontWeight="Bold" Foreground="{Binding ReceiveColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- [3-2] 우측: 결품/지연 알림 영역 -->
            <Border Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 상단 타이틀 및 필터 버튼 영역 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 하단 알림 리스트 영역 -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 카드 타이틀 및 알림 필터 탭 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="납기 관리 요청 현황" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 전체 버튼 -->
                            <RadioButton Content="전체" IsChecked="True" Tag="전체" Checked="NotificationFilter_Checked" Cursor="Hand" Margin="0,0,4,0">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="btnBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock x:Name="btnText" Text="전체" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 지연 버튼 -->
                            <RadioButton Content="지연" Tag="지연" Checked="NotificationFilter_Checked" Cursor="Hand" Margin="0,0,4,0">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="btnBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock x:Name="btnText" Text="지연" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- 결품 버튼 -->
                            <RadioButton Content="보류/대기" Tag="보류/대기" Checked="NotificationFilter_Checked" Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="btnBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                            <TextBlock x:Name="btnText" Text="보류/대기" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource HanwhaOrangeBrush}"/>
                                                <Setter TargetName="btnText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <!-- 알림 데이터 그리드 또는 리스트뷰 -->
                    <ListView x:Name="NotificationListView" Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <!-- Width를 Auto에서 고정 픽셀(예: 75)로 변경하여 시작점을 일치시킴 -->
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 좌측: 아이콘 및 구분 배지 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,10,0">
                                        <Border CornerRadius="4" Padding="6,2" Background="{Binding CategoryBgBrush}" Margin="0,0,6,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" Foreground="{Binding CategoryFgBrush}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 중앙: 기자재명, 요청사항 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding EquipmentName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding NoticeMessage}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </StackPanel>

                                    <!-- 우측: 등록 일시 -->
                                    <TextBlock Grid.Column="2" Text="{Binding RegisterDate}" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>