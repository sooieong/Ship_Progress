<UserControl x:Class="Ship_Progress.Tab1_MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="900" d:DesignWidth="1100">

    <Grid Margin="16">
        <!-- ========================================== -->
        <!-- 레이아웃 정의: 3행 x 2열 구조 (+ 간격 Row/Col) -->
        <!-- ========================================== -->
        <Grid.RowDefinitions>
            <!-- 1행: [상자 1] 호선별 공정률 / [상자 2] 호선별 공정 흐름 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <!-- 2행: [상자 3] 위험 기자재 현황 분포 -->
            <RowDefinition Height="1*"/>
            <RowDefinition Height="12"/>
            <!-- 3행: [상자 4] 협력사별 납기율 / [상자 5] 막대그래프 영역 -->
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- [1행 - 좌측 상자] 호선별 공정률 -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="호선별 공정률" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Center">
                    <!-- H120 -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="H120" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="A SERIES" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                        <Grid Width="150" Height="85">
                            <lvc:PieChart StartingRotationAngle="270" InnerRadius="48" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" Series="{Binding H120GaugeSeries}" LegendLocation="None"/>

                            <!-- Bottom Margin을 24~28 정도로 늘려 수치를 위로 올려 반원 내부 중심에 맞춥니다 -->
                            <TextBlock Text="80.2%" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/>
                        </Grid>
                    </StackPanel>

                    <!-- H121 -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="H121" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="A SERIES" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                        <Grid Width="150" Height="85">
                            <lvc:PieChart StartingRotationAngle="270" InnerRadius="48" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" Series="{Binding H121GaugeSeries}" LegendLocation="None"/>

                            <TextBlock Text="58.8%" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/>
                        </Grid>
                    </StackPanel>

                    <!-- H122 -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="H122" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="A SERIES" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

                        <Grid Width="150" Height="85">
                            <lvc:PieChart StartingRotationAngle="270" InnerRadius="48" Hoverable="False" DataTooltip="{x:Null}" DisableAnimations="True" Background="Transparent" Series="{Binding H122GaugeSeries}" LegendLocation="None"/>

                            <TextBlock Text="22.4%" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/>
                        </Grid>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- [1행 - 우측 상자] 호선별 공정 흐름 -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="호선별 공정 흐름" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                <DataGrid x:Name="ProcessStatusDataGrid" Grid.Row="1" ItemsSource="{Binding CriticalEquipmentList}" 
          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" 
          HeadersVisibility="Column" GridLinesVisibility="Horizontal" 
          HorizontalGridLinesBrush="{DynamicResource BorderBrush}" 
          Background="Transparent" RowHeight="36" BorderThickness="0" VerticalScrollBarVisibility="Auto">

                    <!-- 🔹 [추가] 행(Row) 배경색 및 마우스 오버 시 색상 지정 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Resources>
                        <!-- 🔹 [수정] 텍스트 블록 글자색이 다크모드에서 잘 보이도록 PrimaryTextBrush 연결 -->
                        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 🔹 호선 컬럼: 가운데 정렬 추가 -->
                        <DataGridTextColumn Header="호선" Binding="{Binding ShipNo}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="강재절단" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding SteelCuttingColor}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="블록조립" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding BlockAssemblyColor}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="탑재" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding ErectionColor}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="의장" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding OutfittingColor}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="시운전" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="18" Height="18" Fill="{Binding SeaTrialColor}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- [2행 - 좌측 상자] 위험 기자재 현황 분포 -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="위험 품목 현황 분포" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 위험 아이콘 & 위험 건수 -->
                        <Rectangle Width="10" Height="10" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center">
        <Run Text="위험 "/>
        <Run Text="{Binding TotalCriticalCount}" Foreground="#E53935"/>
        <Run Text="건"/>
                        </TextBlock>

                        <!-- 구분선 (슬래시) -->
                        <TextBlock Text=" / " FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>

                        <!-- 주의 아이콘 & 주의 건수 -->
                        <Rectangle Width="10" Height="10" Fill="#EAB308" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center">
        <Run Text="주의 "/>
        <Run Text="{Binding TotalWarningCount}" Foreground="#EAB308"/>
        <Run Text="건"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <lvc:CartesianChart Grid.Row="1" Series="{Binding EquipmentRiskSeries}" LegendLocation="None" Hoverable="False" DisableAnimations="True" DataTooltip="{x:Null}">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Labels="{Binding EquipmentRiskLabels}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis ShowLabels="False"
              MinValue="0" 
              LabelFormatter="{Binding CountFormatter}" 
              FontSize="10" 
              Foreground="{DynamicResource PrimaryTextBrush}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#33ffffff" StrokeThickness="0.5" Step="2"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- [2~3행 - 우측 대형 상자] 위험 기자재 현황 (표 그대로 2~3행 수직 연장) -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="위험 품목 현황" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                <DataGrid x:Name="CriticalEquipmentDataGrid" Grid.Row="1" ItemsSource="{Binding CriticalEquipmentList}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" Background="Transparent" RowHeight="36" BorderThickness="0" VerticalScrollBarVisibility="Auto">

                    <!-- 🔹 1. 컬럼 헤더 스타일: 라이트/다크 모드 관계없이 항상 고정된 디자인 및 색상 적용 -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- 🔹 2. 행(Row) 스타일: 테마에 따라 배경 및 글자색 동적 변경 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Resources>
                        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <!-- 🔹 3. 셀 내부 텍스트 색상도 테마에 맞게 동적 변경 -->
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- 1. 시리즈 -->
                        <DataGridTextColumn Header="시리즈" Binding="{Binding Series}" Width="80" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 2. 호선 -->
                        <DataGridTextColumn Header="호선" Binding="{Binding ShipNo}" Width="60" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 3. 구분 -->
                        <DataGridTemplateColumn Width="65">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Width="50" Height="24">
                                        <TextBlock Text="구분" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" Foreground="#000000"/>
                                        <Button Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                Click="ProcessFilterButton_Click" Cursor="Hand" ToolTip="구분 필터">
                                            <Path Data="M 2,4 L 18,4 L 11,12 L 11,18 L 9,18 L 9,12 Z" 
                                  Fill="#475569" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Process}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. 품목명 -->
                        <DataGridTextColumn Header="품목명" Binding="{Binding IssueDetail}" Width="*" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 5. 지연 일수 -->
                        <DataGridTextColumn Header="지연 일수" Binding="{Binding DelayDays}" Width="70" ElementStyle="{StaticResource CenterAlignedCell}"/>

                        <!-- 6. 상태 -->
                        <DataGridTemplateColumn Header="상태" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Binding StatusBgColor}">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFgColor}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- ========================================================= -->
        <!-- [3행 - 좌측 분할 영역] 각각 1:1 비율 독립 흰색 상자 2개 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="4" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- [상자 4] 호선별 자재 납기율 (드롭다운 + 오각형 레이더 차트) -->
            <Border Grid.Column="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 타이틀 및 드롭다운 선택 영역 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="호선별 자재 납기율" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                        <ComboBox x:Name="ShipSelectionComboBox" Grid.Column="1" Width="100" Height="26" 
                      SelectedIndex="0" SelectionChanged="ShipSelectionComboBox_SelectionChanged"
                      FontSize="12" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="전체 (평균)"/>
                            <ComboBoxItem Content="H120"/>
                            <ComboBoxItem Content="H121"/>
                            <ComboBoxItem Content="H122"/>
                        </ComboBox>
                    </Grid>

                    <!-- 오각형 레이더 차트 커스텀 렌더링 영역 -->
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid Width="320" Height="260" Margin="10">
                            <!-- 1. 배경 오각형 격자선 -->
                            <Polygon Points="{Binding BackgroundPolygon1}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>
                            <Polygon Points="{Binding BackgroundPolygon2}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>
                            <Polygon Points="{Binding BackgroundPolygon3}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>
                            <Polygon Points="{Binding BackgroundPolygon4}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>
                            <Polygon Points="{Binding BackgroundPolygon5}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Fill="Transparent"/>

                            <!-- 2. 방사형 축 선 -->
                            <Line X1="160" Y1="115" X2="{Binding OuterPoint1.X}" Y2="{Binding OuterPoint1.Y}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Line X1="160" Y1="115" X2="{Binding OuterPoint2.X}" Y2="{Binding OuterPoint2.Y}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Line X1="160" Y1="115" X2="{Binding OuterPoint3.X}" Y2="{Binding OuterPoint3.Y}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Line X1="160" Y1="115" X2="{Binding OuterPoint4.X}" Y2="{Binding OuterPoint4.Y}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Line X1="160" Y1="115" X2="{Binding OuterPoint5.X}" Y2="{Binding OuterPoint5.Y}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>

                            <!-- 3. 실데이터 기반 오각형 영역 (중심점 이동에 맞추어 점 조정 필요) -->
                            <Polygon Points="{Binding RadarPolygonPoints}" 
                 Fill="#77F37321" 
                 Stroke="#F37321" 
                 StrokeThickness="2" 
                 StrokeLineJoin="Round"/>

                            <!-- 5. 5대 의장 부문 축 레이블 -->
                            <TextBlock Text="기자재" Canvas.Top="2" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="기관의장" Margin="265,85,0,0" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="선체의장" Margin="190,215,0,0" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="선실의장" Margin="0,215,190,0" HorizontalAlignment="Right" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="전기의장" Margin="0,85,265,0" HorizontalAlignment="Right" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
            
            <!-- [상자 5] 막대그래프 영역 (추후 구현용 독립 상자) -->
            <Border Grid.Column="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 타이틀: 품목 수급 현황 및 인포메이션 아이콘 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="품목 수급 현황" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                        <!-- 인포메이션 버튼 및 팝업 영역 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button Width="20" Height="20" Cursor="Hand" 
                                    Click="InfoButton_Click" 
                                    MouseEnter="InfoButton_MouseEnter" 
                                    MouseLeave="InfoButton_MouseLeave" 
                                    Background="#E2E8F0" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <TextBlock Text="i" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI" FontStyle="Italic" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 팝업 -->
                            <Popup x:Name="InfoPopup" StaysOpen="False" Placement="Bottom" PopupAnimation="Fade" AllowsTransparency="True">
                                <Border Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,0">
                                    <StackPanel Width="240">
                                        <TextBlock Text="[산출 방식]" FontWeight="Bold" Foreground="Black" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="• 각 호선별 자재의 납품 완료, 지연, 보류 건수를 합산하여 전체 물량 대비 비율을 평균으로 산출합니다." Foreground="#222222" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <!-- 기자재 수급 현황 도넛 차트 영역 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. 도넛 차트 및 중앙 텍스트 -->
                        <Grid Grid.Column="0">
                            <lvc:PieChart Series="{Binding SupplyStatusSeries}" 
                  InnerRadius="55" 
                  Background="Transparent" 
                  LegendLocation="None" 
                  Hoverable="True"
                  DataTooltip="{x:Null}"
                  StartingRotationAngle="-90"/>

                            <!-- 도넛 차트 중앙 텍스트 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OnTimePercentageText}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#4CAF50" 
                   HorizontalAlignment="Center"/>
                                <TextBlock Text="납품 완료" 
                   FontSize="11" 
                   Foreground="{DynamicResource SecondaryTextBrush}" 
                   HorizontalAlignment="Center" 
                   Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2. 우측 커스텀 범례 (Legend) 목록 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <!-- 정상 수급 (On Time) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding OnTimePercentageText}" FontWeight="Bold" FontSize="13" Foreground="#4CAF50" Margin="0,0,6,0"/>
                                    <TextBlock Text="납품 완료" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 지연 (Delayed) - 머스타드색 적용 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#EAB308" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding DelayedPercentageText}" FontWeight="Bold" FontSize="13" Foreground="#EAB308" Margin="0,0,6,0"/>
                                    <TextBlock Text="지연" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 보류/대기 (Pending) - 빨간색 적용 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#E53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding PendingPercentageText}" FontWeight="Bold" FontSize="13" Foreground="#E53935" Margin="0,0,6,0"/>
                                    <TextBlock Text="보류/대기" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>