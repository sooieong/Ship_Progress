<Application x:Class="Ship_Progress.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 기본 라이트 모드 색상 정의 -->
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="MainContentBackgroundBrush" Color="#EBEEF2"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222222"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>

        <!-- 한화오션 공식 오렌지 컬러 (RGB 243, 115, 33) -->
        <SolidColorBrush x:Key="HanwhaOrangeBrush" Color="#F37321"/>

        <!-- 🎯 방사형 그라데이션: 중앙(Center)이 더 밝고 외곽으로 갈수록 은은해지는 효과 -->
        <RadialGradientBrush x:Key="TabCheckedRadialBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
            <!-- Offset 0.0 (중앙): 매우 밝은 투명 오렌지빛 -->
            <GradientStop Color="#15F37321" Offset="0.0"/>
            <!-- Offset 0.6 (중간): 은은하게 짙어짐 -->
            <GradientStop Color="#40F37321" Offset="0.6"/>
            <!-- Offset 1.0 (모서리/외곽): 테두리 색상(#F37321)과 완전히 동일한 색상 -->
            <GradientStop Color="#80F37321" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- 사이드바 탭 버튼 스타일 -->
        <Style x:Key="SidebarTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,10,10,0" 
                                Padding="16,0">
                            <!-- 글자색은 항상 PrimaryTextBrush(검정/흰색) 유지 -->
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 마우스 호버 시 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                            </Trigger>
                            <!-- 탭 선택(Checked) 시 스타일 변경 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource TabCheckedRadialBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource HanwhaOrangeBrush}"/>
                                <!-- 🎯 테두리를 0.8px로 매우 얇게 지정 (좌측 테두리는 0) -->
                                <Setter Property="BorderThickness" Value="0,0.5,0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>